generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  email              String              @unique
  password           String
  name               String?
  rol                String               @default("Usuario") // "Administrador" o "Usuario"
  trialPlanUsado     Boolean             @default(false) @map("trial_plan_usado")
  trialUnidadUsada   Boolean             @default(false) @map("trial_unidad_usada")
  trialSesionUsada   Boolean             @default(false) @map("trial_sesion_usada")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  id                 Int                  @id @default(autoincrement())
  planesAnuales      PlanAnual[]
  unidadesAprendizaje UnidadAprendizaje[]
  ordenesCompra      OrdenCompra[]
  suscripciones      SuscripcionUsuario[]
}

model Area {
  id                 Int                 @id @default(autoincrement())
  descripcion        String
  sesionx2           Boolean?            @default(false)
  competencias       Competencia[]
  procesosDidacticos ProcesoDidactico[]
  sugerenciasProducto SugerenciaProductoPlan[]

  @@map("area")
}

model ProcesoDidactico {
  idproceso          Int    @id @default(autoincrement()) @map("idproceso")
  descripcion        String
  competenciaProceso Json   @map("competencia_proceso") // array de strings: competencias del proceso
  idarea             Int    @map("idarea")
  area               Area   @relation(fields: [idarea], references: [id])

  @@map("procesodidactico")
}

model Nivel {
  id           Int           @id @default(autoincrement())
  descripcion  String
  competencias Competencia[]

  @@map("nivel")
}

model Ciclo {
  id          Int     @id @default(autoincrement()) @map("idciclo")
  descripcion String
  grados      Grado[]

  @@map("ciclo")
}

model Grado {
  id                Int               @id @default(autoincrement())
  descripcion       String?
  idciclo           Int
  ciclo             Ciclo             @relation(fields: [idciclo], references: [id])
  competencias      Competencia[]
  comptransversales Comptransversal[]

  @@map("grado")
}

model Comptransversal {
  idcomtransversal       Int                    @id @default(autoincrement()) @map("idcomtransversal")
  descripcion            String
  idgrado                Int
  grado                  Grado                  @relation(fields: [idgrado], references: [id])
  capacidadtransversales Capacidadtransversal[]

  @@map("comptransversal")
}

model Capacidadtransversal {
  idcapacidadtransversal Int             @id @default(autoincrement()) @map("idcapacidadtransversal")
  descripcion            String
  idcomtransversal       Int
  comptransversal        Comptransversal @relation(fields: [idcomtransversal], references: [idcomtransversal])
  desempeniotransversales Desempeniotransversal[]

  @@map("capacidadtransversal")
}

model Desempeniotransversal {
  iddesempeniotransversal Int    @id @default(autoincrement()) @map("iddesempeniotransversal")
  descripcion             String
  idcapacidadtransversal  Int
  capacidadtransversal    Capacidadtransversal @relation(fields: [idcapacidadtransversal], references: [idcapacidadtransversal])

  @@map("desempeniotransversal")
}

model Competencia {
  id                Int         @id @default(autoincrement())
  descripcion       String
  numeroCompetencia Int         @map("numero_competencia")
  transversal       Boolean?    @default(false)
  idarea            Int
  idgrado           Int
  idnivel           Int
  area              Area        @relation(fields: [idarea], references: [id])
  grado             Grado       @relation(fields: [idgrado], references: [id])
  nivel             Nivel       @relation(fields: [idnivel], references: [id])
  estandares        Estandar[]
  capacidades       Capacidad[]

  @@map("competencia")
}

model Estandar {
  id            Int         @id @default(autoincrement())
  descripcion   String
  ordenamiento  Int
  idcompetencia Int
  competencia   Competencia @relation(fields: [idcompetencia], references: [id])
  capacidades   Capacidad[]

  @@map("estandar")
}

model Capacidad {
  id            Int          @id @default(autoincrement())
  descripcion   String
  idcompetencia Int
  idstandar     Int
  competencia   Competencia  @relation(fields: [idcompetencia], references: [id])
  estandar      Estandar     @relation(fields: [idstandar], references: [id])
  desempenios   Desempenio[]

  @@map("capacidad")
}

model Desempenio {
  id          Int       @id @default(autoincrement())
  descripcion String
  idcapacidad Int
  capacidad   Capacidad @relation(fields: [idcapacidad], references: [id])

  @@map("desempenio")
}

model PlanAnual {
  id        Int      @id @default(autoincrement())
  idusuario Int      @map("idusuario")
  anio      Int
  fechaHora DateTime @default(now()) @map("fechahora")

  // Datos de Fase 1
  area         String?
  areaId       String  @default("") @map("area_id")
  grado        String?
  gradoId      String  @default("") @map("grado_id")
  institucion  String?
  docente      String?
  dre          String?
  ugel         String?
  director     String?
  coordinador  String?
  nivel        String?
  nivelId      String  @default("") @map("nivel_id")
  departamento String?
  provincia    String?
  distrito     String?

  // Datos de Fase 2 y variables dinámicas del template (JSON)
  unidades          Json? // Array de unidades con todos sus datos
  variablesTemplate Json? @map("variables_template") // Variables dinámicas del template

  // Relación con User
  usuario User @relation(fields: [idusuario], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([idusuario, anio, areaId, nivelId, gradoId], name: "plananual_usuario_anio_area_nivel_grado")
  @@map("plananual")
}

model UnidadAprendizaje {
  id        Int      @id @default(autoincrement())
  idusuario Int      @map("idusuario")
  idplananual Int?   @map("idplananual") // Relación opcional con PlanAnual
  anio      Int
  fechaHora DateTime @default(now()) @map("fechahora")

  // Datos básicos
  area         String?
  areaId       String? @map("area_id")
  grado        String?
  gradoId      String? @map("grado_id")
  ciclo        String?
  cicloId      String? @map("ciclo_id")
  unidad       String? // Número de unidad (ej: "1", "2", etc.)
  
  // Datos institucionales
  institucion  String?
  tipoIE       String? @map("tipo_ie")
  director     String?
  docente      String?
  duracion     String?
  
  // Datos temporales
  fechaInicio  String? @map("fecha_inicio")
  fechaTermino String? @map("fecha_termino")
  
  // Datos de contenido
  situacionSignificativa String? @db.Text @map("situacion_significativa")
  producto               String? @db.Text
  tituloUnidad            String? @map("titulo_unidad")
  propositoUnidad         String? @db.Text @map("proposito_unidad")
  competencias            Json? // Array de IDs de competencias
  campoTematico           String? @db.Text @map("campo_tematico")
  numeroSesiones          String? @map("numero_sesiones")
  instrumentoEvaluacion   String? @map("instrumento_evaluacion")
  
  // Sesiones (JSON) - Array de sesiones con sus datos (legacy, se mantiene por compatibilidad)
  sesiones Json? // Array de sesiones: [{ titulo, competenciasSeleccionadas, capacidadesSeleccionadas, desempeniosSeleccionados, instrumentoEvaluacion }]

  // Sesiones en tabla normalizada (una fila por sesión generada por IA)
  listaSesiones Sesion[]

  // Enfoques transversales (JSON) - Array de { enfoque, valor, actitud }
  enfoquesTransversales Json? @map("enfoques_transversales")
  
  // Variables dinámicas del template (JSON)
  variablesTemplate Json? @map("variables_template") // Variables dinámicas del template (aiProvider, openaiModel, etc.)

  // Relación con User
  usuario User @relation(fields: [idusuario], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([idusuario, anio, areaId, gradoId, unidad])
  @@map("unidadaprendizaje")
}

model Sesion {
  id                      Int      @id @default(autoincrement())
  idunidadaprendizaje     Int      @map("idunidadaprendizaje")
  numeroSesion            Int      @map("numero_sesion") // 1, 2, 3... orden dentro de la unidad

  // Controles mapeados de Fase 1 del wizard (sesiones-fichas)
  area                    String?  // Área Curricular
  areaId                  String?  @map("area_id")
  grado                   String?  // Grado Escolar
  gradoId                 String?  @map("grado_id")
  ciclo                   String?  // Ciclo (según grado)
  cicloId                 String?  @map("ciclo_id")
  institucion             String?  // Nombre de la Institución Educativa (Opcional)
  director                String?  // Director (Opcional)
  docente                 String?  // Nombre del docente (Opcional)
  duracion                String?  // Duración: 45, 90, 135 minutos (Opcional)
  fecha                   String?  // Fecha (Opcional)
  unidad                  String?  // Unidad - ej: 1, 2, 3 (Opcional)

  // Controles mapeados de Fase 2 del wizard (sesiones-fichas)
  titulo                  String?  @db.Text
  campoTematico           String?  @db.Text @map("campo_tematico")
  criterios               String?  @db.Text
  evidencias              String?  @db.Text
  instrumentoEvaluacion   String?  @map("instrumento_evaluacion")
  competenciasSeleccionadas Json?   @map("competencias_seleccionadas")
  capacidadesSeleccionadas Json?   @map("capacidades_seleccionadas")
  desempeniosSeleccionados Json?   @map("desempenios_seleccionados")

  // Contenido extraído de la IA (para generar documento sin volver a llamar a la IA)
  motivacion         String? @db.Text
  saberes            String? @db.Text
  problematizacion   String? @db.Text
  proposito          String? @db.Text
  standar            String? @db.Text
  desarrolloantes    String? @db.Text
  desarrollodurante  String? @db.Text
  desarrollodespues  String? @db.Text
  desarrollo         String? @db.Text
  metacognicion      String? @db.Text

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  unidadAprendizaje UnidadAprendizaje @relation(fields: [idunidadaprendizaje], references: [id], onDelete: Cascade)
  fichaAprendizaje   FichaAprendizaje?
  rubrica            Rubrica?
  solucionario       Solucionario?
  listaCotejo        ListaCotejo?

  @@unique([idunidadaprendizaje, numeroSesion])
  @@map("sesion")
}

model Rubrica {
  id               Int      @id @default(autoincrement())
  idsesion         Int      @unique @map("idsesion")
  area             String?  @db.Text
  competencia      String?  @db.Text
  capacidad        String?  @db.Text
  standar          String?  @db.Text
  grado            String?  @db.Text
  titulosesion     String?  @db.Text @map("titulosesion")
  evidencia        String?  @db.Text
  proposito        String?  @db.Text
  tabladinamica    String?  @db.Text @map("tabladinamica")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sesion Sesion @relation(fields: [idsesion], references: [id], onDelete: Cascade)

  @@map("rubrica")
}

model FichaAprendizaje {
  id                 Int      @id @default(autoincrement())
  idsesion           Int      @unique @map("idsesion")
  area               String?  @db.Text
  grado              String?  @db.Text
  titulosesion       String?  @db.Text @map("titulosesion")
  titulodesesion     String?  @db.Text @map("titulodesesion")
  proposito          String?  @db.Text
  competencia        String?  @db.Text
  capacidad          String?  @db.Text
  evidencia          String?  @db.Text
  criterios          String?  @db.Text
  saber1             String?  @db.Text
  saber2             String?  @db.Text
  saber3             String?  @db.Text
  respuestaprompt    String?  @db.Text @map("respuestaprompt")
  duracion           String?  @db.Text
  desarrolloantes    String?  @db.Text @map("desarrolloantes")
  desarrollodurante  String?  @db.Text @map("desarrollodurante")
  desarrollodespues  String?  @db.Text @map("desarrollodespues")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  sesion Sesion @relation(fields: [idsesion], references: [id], onDelete: Cascade)

  @@map("fichaaprendizaje")
}

model Solucionario {
  id              Int      @id @default(autoincrement())
  idsesion        Int      @unique @map("idsesion")
  area            String?  @db.Text
  grado           String?  @db.Text
  titulosesion    String?  @db.Text @map("titulosesion")
  respuestaprompt String?  @db.Text @map("respuestaprompt")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sesion Sesion @relation(fields: [idsesion], references: [id], onDelete: Cascade)

  @@map("solucionario")
}

/** Instrumento de evaluación — Lista de cotejo (plantilla Word por sesión). */
model ListaCotejo {
  id           Int      @id @default(autoincrement())
  idsesion     Int      @unique @map("idsesion")
  area         String?  @db.Text
  grado        String?  @db.Text
  docente      String?  @db.Text
  ciclo        String?  @db.Text
  titulosesion String?  @db.Text @map("titulosesion")
  proposito    String?  @db.Text
  competencia  String?  @db.Text
  capacidades  String?  @db.Text
  evidencia    String?  @db.Text
  criterio1    String?  @db.Text
  criterio2    String?  @db.Text
  criterio3    String?  @db.Text
  criterio4    String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sesion Sesion @relation(fields: [idsesion], references: [id], onDelete: Cascade)

  @@map("listacotejo")
}

model Prompt {
  idprompt          Int      @id @default(autoincrement()) @map("idprompt")
  descripcion       String
  contenido         String   @db.Text
  fechacreacion     DateTime @default(now()) @map("fechacreacion")
  fechamodificacion DateTime @updatedAt @map("fechamodificacion")
  estado            String   @default("activo") // "activo" o "inactivo"

  @@map("prompt")
}

/** Sugerencias de problema/potencialidad y campo temático para plan anual */
model SugerenciaProblemaPlan {
  id          Int    @id @default(autoincrement())
  descripcion String @db.Text

  @@map("sugerencia_problema_plan")
}

/** Sugerencias de producto para plan anual (por área curricular) */
model SugerenciaProductoPlan {
  id          Int    @id @default(autoincrement())
  descripcion String @db.Text
  idarea      Int?
  area        Area?  @relation(fields: [idarea], references: [id])

  @@index([idarea])
  @@map("sugerencia_producto_plan")
}

model AreaComercial {
  idareacomercial Int      @id @default(autoincrement()) @map("idareacomercial")
  descripcion     String
  areaIds         Json     @map("area_ids") // Array de IDs de Area, ej: [1,2,3,4]
  estado          String   @default("activo") // "activo" o "inactivo"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("areacomercial")
}

model TipoVenta {
  id          Int    @id @default(autoincrement())
  descripcion String
  estado      String @default("activo") // "activo" o "inactivo"

  @@map("tipoventa")
}

model EnfoqueTransversal {
  idenfoque      Int       @id @default(autoincrement()) @map("idenfoque")
  descripcion    String
  idnivel        String
  idgrado        String
  enfoqueValores EnfoVal[]

  @@map("enfoquetransversal")
}

model Valores {
  idvalor          Int              @id @default(autoincrement()) @map("idvalor")
  descripcion      String
  actitud          String
  enfoqueValores   EnfoVal[]
  valorActividades ValAct[]
  actDemostrables  ActDemostrable[]

  @@map("valores")
}

model EnfoVal {
  idenfoval Int                @id @default(autoincrement()) @map("idenfoval")
  idenfoque Int
  idvalor   Int
  enfoque   EnfoqueTransversal @relation(fields: [idenfoque], references: [idenfoque])
  valor     Valores            @relation(fields: [idvalor], references: [idvalor])

  @@map("enfo_val")
}

model ActDemostrable {
  idactdemostrable Int      @id @default(autoincrement()) @map("idactdemostrable")
  descripcion      String
  idvalor          Int      @default(1)
  valor            Valores  @relation(fields: [idvalor], references: [idvalor])
  valorActividades ValAct[]

  @@map("actdemostrable")
}

model ValAct {
  idvalact         Int            @id @default(autoincrement()) @map("idvalact")
  idvalor          Int
  idactdemostrable Int
  valor            Valores        @relation(fields: [idvalor], references: [idvalor])
  actdemostrable   ActDemostrable @relation(fields: [idactdemostrable], references: [idactdemostrable])

  @@map("val_act")
}

/// Orden de compra creada desde /planes/comprar (alineada a Culqi)
model OrdenCompra {
  id                Int      @id @default(autoincrement())
  idusuario         Int      @map("idusuario")
  planCodigo        String?  @map("plan_codigo") // basico | premium | anual
  vigencia          String   // mensual | anual
  sesionesPorUnidad Int      @map("sesiones_por_unidad") // 5 o 10
  cantidadGrados    Int      @map("cantidad_grados") // 1..5
  monto             Decimal  @db.Decimal(10, 2)
  moneda            String   @default("PEN")
  estado            String   @default("pendiente") // pendiente | pagada | fallida | cancelada
  culqiOrderId      String?  @map("culqi_order_id")
  culqiChargeId     String?  @map("culqi_charge_id")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  usuario       User                 @relation(fields: [idusuario], references: [id], onDelete: Cascade)
  pagos         PagoCulqi[]
  suscripciones SuscripcionUsuario[]

  @@index([idusuario, estado])
  @@index([culqiOrderId])
  @@index([culqiChargeId])
  @@map("orden_compra")
}

/// Eventos/cargos de Culqi asociados a una orden (auditoría de pagos)
model PagoCulqi {
  id            Int      @id @default(autoincrement())
  idorden       Int      @map("idorden")
  culqiId       String   @map("culqi_id")
  estado        String   // captured | failed | refunded | etc.
  metodo        String?  // tarjeta, yape, etc.
  monto         Decimal  @db.Decimal(10, 2)
  moneda        String   @default("PEN")
  respuestaRaw  Json?    @map("respuesta_raw")
  createdAt     DateTime @default(now()) @map("created_at")

  orden OrdenCompra @relation(fields: [idorden], references: [id], onDelete: Cascade)

  @@index([idorden])
  @@unique([culqiId])
  @@map("pago_culqi")
}

/// Acceso comercial activo del usuario (mensual/anual)
model SuscripcionUsuario {
  id                         Int      @id @default(autoincrement())
  idusuario                  Int      @map("idusuario")
  idorden                    Int?     @map("idorden")
  planCodigo                 String?  @map("plan_codigo") // basico | premium | anual
  vigencia                   String   // mensual | anual
  sesionesPorUnidad          Int      @map("sesiones_por_unidad") // 5 o 10
  cantidadGrados             Int      @map("cantidad_grados") // 1..5
  creditosRegeneracionTotal  Int      @default(0) @map("creditos_regeneracion_total")
  creditosRegeneracionUsados Int      @default(0) @map("creditos_regeneracion_usados")
  fechaInicio                DateTime @map("fecha_inicio")
  fechaFin                   DateTime @map("fecha_fin")
  estado                     String   @default("activa") // activa | pendiente_grados | vencida | cancelada
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  usuario User        @relation(fields: [idusuario], references: [id], onDelete: Cascade)
  orden   OrdenCompra? @relation(fields: [idorden], references: [id], onDelete: SetNull)
  grados  SuscripcionGrado[]

  @@index([idusuario, estado, fechaFin])
  @@index([idorden])
  @@map("suscripcion_usuario")
}

/// Grados/áreas habilitados por suscripción pagada
model SuscripcionGrado {
  id             Int      @id @default(autoincrement())
  idsuscripcion  Int      @map("idsuscripcion")
  areaId         String   @map("area_id")
  gradoId        String   @map("grado_id")
  nivelId        String?  @map("nivel_id")
  createdAt      DateTime @default(now()) @map("created_at")

  suscripcion SuscripcionUsuario @relation(fields: [idsuscripcion], references: [id], onDelete: Cascade)

  @@unique([idsuscripcion, areaId, gradoId], name: "suscripcion_area_grado_unico")
  @@index([areaId, gradoId])
  @@map("suscripcion_grado")
}

/// Registro de cada operación de sellado (código + fecha) en /sello-documentos
model RegistroSelloDocumento {
  id               Int      @id @default(autoincrement())
  codigoeducaplus  String   @map("codigoeducaplus")
  cantidadArchivos Int      @default(1) @map("cantidad_archivos")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([codigoeducaplus])
  @@index([createdAt])
  @@map("registro_sello_documento")
}

/// Catálogo comercial Básico / Premium / Anual (precio, restricciones, textos UI)
model PlanCatalogo {
  id                   Int      @id @default(autoincrement())
  codigo               String   @unique @map("codigo")
  nombre               String
  precio               Decimal  @db.Decimal(10, 2)
  periodo              String   // mes | anual
  vigencia             String   // mensual | anual
  sesionesPorUnidad    Int      @map("sesiones_por_unidad")
  creditosRegeneracion Int      @map("creditos_regeneracion")
  creditosEtiqueta     String   @map("creditos_etiqueta")
  maxParesAreaGrado    Int      @map("max_pares_area_grado")
  generacionTitulo     String   @map("generacion_titulo")
  destacado            String?
  etiqueta             String?
  cta                  String
  tema                 String   @default("azul")
  notaUsoJusto         String?  @map("nota_uso_justo")
  orden                Int      @default(0)
  estado               String   @default("activo")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  items   PlanCatalogoItem[]
  limites PlanCatalogoLimite[]

  @@map("plan_catalogo")
}

model PlanCatalogoItem {
  id             Int          @id @default(autoincrement())
  idPlanCatalogo Int          @map("id_plan_catalogo")
  tipo           String       // generacion | beneficio
  texto          String
  orden          Int          @default(0)

  plan PlanCatalogo @relation(fields: [idPlanCatalogo], references: [id], onDelete: Cascade)

  @@index([idPlanCatalogo, tipo, orden])
  @@map("plan_catalogo_item")
}

model PlanCatalogoLimite {
  id             Int          @id @default(autoincrement())
  idPlanCatalogo Int          @map("id_plan_catalogo")
  tipoDocumento  String       @map("tipo_documento")
  limiteMensual  Int?         @map("limite_mensual")
  limiteAnual    Int?         @map("limite_anual")

  plan PlanCatalogo @relation(fields: [idPlanCatalogo], references: [id], onDelete: Cascade)

  @@unique([idPlanCatalogo, tipoDocumento])
  @@map("plan_catalogo_limite")
}
